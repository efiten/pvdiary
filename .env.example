# Geheim token waarmee Home Assistant (Node-RED) data mag posten.
# Genereer met: openssl rand -hex 32
INGEST_TOKEN=

# Locatie van de panelen (decimale graden), voor zonsopgang/-ondergang,
# clear-sky-curve en weersverwachting.
PVDIARY_LAT=
PVDIARY_LON=

# Panelen per string/dakvlak: naam:wattpiek:azimut:helling:tempcoeff
# azimut = kompasrichting (0=N, 90=O, 180=Z, 270=W), helling in graden,
# tempcoeff in %/°C (datasheet, typisch -0.30 tot -0.40).
# Meerdere strings scheiden met een komma.
PVDIARY_STRINGS=Zuid:4000:180:35:-0.35

# Optioneel: elektriciteitsprijs (EUR/kWh) en CO2-factor (kg/kWh) voor de opbrengst-view.
PVDIARY_ELE_COST=0.18
PVDIARY_CO2=0.596
