[
  {
    "id": "pvdiary_ingest",
    "type": "tab",
    "label": "PVdiary Ingest",
    "disabled": false,
    "info": ""
  },
  {
    "id": "pv_setup_note",
    "type": "comment",
    "name": "⚠️ SETUP REQUIRED: (1) Edit both state nodes (pv_power_state, pv_day_state) and set their HA server config. (2) Edit both function nodes (pv_power_fn, pv_day_fn) and replace __INGEST_TOKEN__ with your INGEST_TOKEN.",
    "info": "",
    "x": 50,
    "y": 20,
    "z": "pvdiary_ingest",
    "wires": []
  },
  {
    "id": "pv_sample_tick",
    "type": "inject",
    "name": "elke 5 min",
    "repeat": "300",
    "crontab": "",
    "once": true,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 100,
    "z": "pvdiary_ingest",
    "wires": [["pv_power_state"]]
  },
  {
    "id": "pv_power_state",
    "type": "api-current-state",
    "name": "Get PV Power",
    "entity_id": "__PV_POWER_ENTITY__",
    "state_type": "num",
    "override_topic": false,
    "override_payload": "msg",
    "entity_location": "data.entity_id",
    "state_location": "data.state",
    "override_data": "msg",
    "characteristicProperties": "[]",
    "server": "REPLACE_WITH_SERVER_ID",
    "x": 350,
    "y": 100,
    "z": "pvdiary_ingest",
    "wires": [["pv_power_fn"]]
  },
  {
    "id": "pv_power_fn",
    "type": "function",
    "name": "build sample",
    "func": "msg.headers={'Authorization':'Bearer __INGEST_TOKEN__'};\nmsg.payload={collector:'__COLLECTOR__',ts:Math.floor(Date.now()/1000),power_w:Math.round(Number(msg.data.state))};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 550,
    "y": 100,
    "z": "pvdiary_ingest",
    "wires": [["pv_power_post"]]
  },
  {
    "id": "pv_power_post",
    "type": "http request",
    "name": "POST /api/ingest/sample",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "__PVDIARY_URL__/api/ingest/sample",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "authentication": {},
    "customHeaders": true,
    "sendErr": false,
    "headerKeyInput": "headers",
    "headers": [],
    "x": 750,
    "y": 100,
    "z": "pvdiary_ingest",
    "wires": [[]]
  },
  {
    "id": "pv_day_tick",
    "type": "inject",
    "name": "dag elke 5 min",
    "repeat": "300",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 200,
    "z": "pvdiary_ingest",
    "wires": [["pv_day_state"]]
  },
  {
    "id": "pv_day_state",
    "type": "api-current-state",
    "name": "Get PV Energy Today",
    "entity_id": "__PV_ENERGY_ENTITY__",
    "state_type": "num",
    "override_topic": false,
    "override_payload": "msg",
    "entity_location": "data.entity_id",
    "state_location": "data.state",
    "override_data": "msg",
    "characteristicProperties": "[]",
    "server": "REPLACE_WITH_SERVER_ID",
    "x": 350,
    "y": 200,
    "z": "pvdiary_ingest",
    "wires": [["pv_day_fn"]]
  },
  {
    "id": "pv_day_fn",
    "type": "function",
    "name": "build day",
    "func": "const d=new Date();\nconst p=(n)=>String(n).padStart(2,'0');\nconst date=`${d.getFullYear()}${p(d.getMonth()+1)}${p(d.getDate())}`;\nmsg.headers={'Authorization':'Bearer __INGEST_TOKEN__'};\nmsg.payload={collector:'__COLLECTOR__',date,energy_wh:Math.round(Number(msg.data.state)*1000)};\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "x": 550,
    "y": 200,
    "z": "pvdiary_ingest",
    "wires": [["pv_day_post"]]
  },
  {
    "id": "pv_day_post",
    "type": "http request",
    "name": "POST /api/ingest/day",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "__PVDIARY_URL__/api/ingest/day",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "",
    "authentication": {},
    "customHeaders": true,
    "sendErr": false,
    "headerKeyInput": "headers",
    "headers": [],
    "x": 750,
    "y": 200,
    "z": "pvdiary_ingest",
    "wires": [[]]
  }
]
